# Public URL of the deployed site, used for canonical URLs, the sitemap and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Sanity CMS. The project ID and dataset are not secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Read-only (Viewer) token. Needed for draft previews in Studio's Presentation tool. Server-side only.
SANITY_API_READ_TOKEN=

# Editor token, only needed to run `npm run migrate:insights`. Use a short expiry and revoke it afterwards.
SANITY_API_WRITE_TOKEN=

# Optional. Shared secret for a Sanity webhook that calls /api/revalidate on publish.
SANITY_REVALIDATE_SECRET=

# Enquiry email delivery via Resend (https://resend.com). All three are required to send email.
# Without them, enquiries are saved to .enquiries/enquiries.ndjson in development,
# and the form shows an honest "not connected" message in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
